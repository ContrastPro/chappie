BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
BINANCE_TESTNET_ACCOUNT_FINGERPRINT=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
TESTNET_EXECUTION_ENABLED=false
BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
TRADING_MODE=paper
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1m
MARKET_CACHE_CAPACITY=1000
POLLING_CADENCE_SECONDS=10.0
POLLING_BOOTSTRAP_LIMIT=1000
POLLING_REGULAR_LIMIT=2
MAX_CONSECUTIVE_FAILURES=3
MARKET_CLOCK_SKEW_WARNING_SECONDS=5
RUN_LOG_FILE=logs/latest_run.log
# Set a positive integer for a finite diagnostic run; leave empty for Ctrl+C mode.
SMOKE_RUN_CYCLES=
SHADOW_DECISIONS_ENABLED=false
PAPER_TRADING_ENABLED=false
PERSISTENCE_ENABLED=false
PERSISTENCE_BACKEND=sqlite
SQLITE_PATH=data/chappie-paper.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
PORTFOLIO_CHECKPOINT_INTERVAL_TRANSITIONS=100
PAPER_PORTFOLIO_ID=paper-btcusdt-main
DECISION_COORDINATOR_HISTORY_LIMIT=1000
DECISION_COORDINATOR_DEDUP_CAPACITY=10000
PAPER_INITIAL_QUOTE_BALANCE=10000
PAPER_FEE_RATE=0.001
PAPER_EXECUTION_LATENCY_MS=0
PAPER_DEDUP_CAPACITY=10000
SHADOW_HISTORY_LIMIT=1000
SHADOW_DEDUP_CAPACITY=10000
SNAPSHOT_STALE_AFTER_MS=120000
EMA_FAST_WINDOW=12
EMA_SLOW_WINDOW=26
# Pure signal selection: ema_crossover | trend_filtered | breakout | mean_reversion
STRATEGY_NAME=ema_crossover
TREND_ATR_WINDOW=14
TREND_MINIMUM_SPREAD_BPS=8
TREND_MINIMUM_ATR_BPS=5
BREAKOUT_LOOKBACK=20
BREAKOUT_ATR_WINDOW=14
BREAKOUT_MINIMUM_ATR_BPS=5
BREAKOUT_EXIT_FRACTION=0.5
MEAN_REVERSION_LOOKBACK=20
MEAN_REVERSION_ENTRY_DEVIATION_BPS=35
MEAN_REVERSION_EXIT_DEVIATION_BPS=0
LONG_TARGET_EXPOSURE=1
