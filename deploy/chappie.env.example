# Copy to /etc/chappie/chappie.env, then set owner root:chappie and mode 0640.
# This tracked template contains placeholders only. Never commit the copied file.

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_DIRECTORY=/var/lib/chappie/logs
RUN_LOG_FILE=/var/lib/chappie/logs/latest_run.log
SERVER_STATUS_FILE=/var/lib/chappie/logs/chappie-status.json

DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1m
POLLING_CADENCE_SECONDS=10

# First deployment profile: Paper only.
TRADING_MODE=paper
PAPER_TRADING_ENABLED=true
PERSISTENCE_ENABLED=true
SQLITE_PATH=/var/lib/chappie/data/chappie-paper.sqlite3
TESTNET_EXECUTION_ENABLED=false

# Testnet is a separately authorized, bounded operator step. It is not enabled
# in the installed Paper service. Use a secured, untracked environment file.
# TRADING_MODE=testnet
# PAPER_TRADING_ENABLED=false
# PERSISTENCE_ENABLED=true
# SQLITE_PATH=/var/lib/chappie/data/testnet_mvp.sqlite3
# TESTNET_EXECUTION_ENABLED=true
# BINANCE_TESTNET_API_KEY=__SET_IN_SECRET_MANAGER__
# BINANCE_TESTNET_SECRET_KEY=__SET_IN_SECRET_MANAGER__
# BINANCE_TESTNET_ACCOUNT_FINGERPRINT=__SET_OPERATOR_ACCOUNT_FINGERPRINT__

# LIVE is unavailable. Do not set TRADING_MODE=live.
