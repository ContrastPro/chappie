BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
TRADING_MODE=paper
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1m
MARKET_CACHE_CAPACITY=1000
POLLING_CADENCE_SECONDS=10.0
POLLING_BOOTSTRAP_LIMIT=1000
POLLING_REGULAR_LIMIT=2
MAX_CONSECUTIVE_FAILURES=3
MARKET_CLOCK_SKEW_WARNING_SECONDS=5
RUN_LOG_FILE=logs/latest_run.log
# Set a positive integer for a finite diagnostic run; leave empty for Ctrl+C mode.
SMOKE_RUN_CYCLES=
SHADOW_DECISIONS_ENABLED=false
SHADOW_HISTORY_LIMIT=1000
SHADOW_DEDUP_CAPACITY=10000
SNAPSHOT_STALE_AFTER_MS=120000
EMA_FAST_WINDOW=12
EMA_SLOW_WINDOW=26
LONG_TARGET_EXPOSURE=1
